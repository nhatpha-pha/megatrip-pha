PORT=8080
NODE_ENV=development

# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/megatrip?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/megatrip

# ===== JWT =====
JWT_ACCESS_SECRET=7d
JWT_REFRESH_SECRET=30s

JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# ===== CORS: các domain frontend được phép gọi API (cách nhau dấu phẩy, KHÔNG có dấu / ở cuối) =====
CORS_ORIGIN=https://megatrip-pha-megatrip-client.vercel.app,https://megatrip-pha-ra2g.vercel.app,http://localhost:3000,http://localhost:3001

# ===== URL công khai =====
CLIENT_URL=https://megatrip-pha-megatrip-client.vercel.app
API_PUBLIC_URL=https://megatrip-pha-backend.onrender.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nhatpha.nasani@gmail.com
SMTP_PASS=qpqf dpcr mwnx wlub
SMTP_FROM="MegaTrip <nhatpha.nasani@gmail.com>"

# ===== Admin mặc định 
ADMIN_EMAIL=admin@megatrip.vn
ADMIN_PASSWORD=Admin@123

# ===== Cloudinary (lưu ảnh upload) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== VNPay (sandbox) =====
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Chỉ dùng khi frontend không gửi returnUrl (frontend hiện tại có gửi nên có thể bỏ qua)
VNPAY_RETURN_URL=http://localhost:8080/vnpay/check-payment

# ===== MoMo (sandbox) =====
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
# Để trống = tự chuyển về CLIENT_URL/thanh-toan-thanh-cong
MOMO_REDIRECT_URL=
# MoMo gọi ngược về server: phải là URL công khai (Render), ví dụ https://megatrip-pha-backend.onrender.com/momo/ipn
MOMO_IPN_URL=https://megatrip-pha-backend.onrender.com/momo/ipn

# ===== ZaloPay (sandbox) =====
ZALOPAY_APP_ID=your_zalopay_app_id
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_REFUND_ENDPOINT=https://sb-openapi.zalopay.vn/v2/refund
# ZaloPay gọi ngược về server: URL công khai, ví dụ https://megatrip-pha-backend.onrender.com/zalo/callback
ZALOPAY_CALLBACK_URL=https://megatrip-pha-backend.onrender.com/zalo/callback

# ===== Gemini AI (chatbot) - chỉ để ở server, KHÔNG dùng NEXT_PUBLIC_* =====
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ===== Amadeus (tra cứu chuyến bay) - chỉ để ở server =====
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret
